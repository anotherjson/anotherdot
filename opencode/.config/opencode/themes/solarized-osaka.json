    "markdownHorizontalRule": { "dark": "base01", "light": "base01" },
    "markdownListItem": { "dark": "blue", "light": "blue" },
    "markdownListEnumeration": { "dark": "cyan", "light": "cyan" },
    "markdownImage": { "dark": "cyan", "light": "cyan" },
    "markdownImageText": { "dark": "violet", "light": "violet" },
    "markdownCodeBlock": { "dark": "fg", "light": "fg" },
    "syntaxComment": { "dark": "base01", "light": "base01" },
    "syntaxKeyword": { "dark": "green", "light": "green" },
    "syntaxFunction": { "dark": "blue", "light": "blue" },
    "syntaxVariable": { "dark": "cyan", "light": "cyan" },
    "syntaxString": { "dark": "cyan", "light": "cyan" },
    "syntaxNumber": { "dark": "magenta", "light": "magenta" },
