    "diffRemoved": { "dark": "red", "light": "red" },
    "diffContext": { "dark": "base01", "light": "base01" },
    "diffHunkHeader": { "dark": "base01", "light": "base01" },
    "diffHighlightAdded": { "dark": "green", "light": "green" },
    "diffHighlightRemoved": { "dark": "red", "light": "red" },
    "diffAddedBg": { "dark": "base02", "light": "base02" },
    "diffRemovedBg": { "dark": "base02", "light": "base02" },
    "diffContextBg": { "dark": "base02", "light": "base02" },
    "diffLineNumber": { "dark": "base01", "light": "base01" },
    "diffAddedLineNumberBg": { "dark": "base02", "light": "base02" },
    "diffRemovedLineNumberBg": { "dark": "base02", "light": "base02" },
    "markdownText": { "dark": "fg", "light": "fg" },
    "markdownHeading": { "dark": "blue", "light": "blue" },
    "markdownLink": { "dark": "cyan", "light": "cyan" },
    "markdownLinkText": { "dark": "violet", "light": "violet" },
