-- Machine-local monitor layout. `just host-init` copies this once to ~/.config/hypr/monitors.lua;
-- edit that copy freely: it is gitignored, never overwritten, and Hyprland reloads it on save.
-- Output names: `hyprctl monitors`. Use "desc:<description>" instead of a name to pin a panel.
-- Reference: https://wiki.hypr.land/configuring/core/monitors/

-- Default: every output at its preferred mode, auto-placed, auto scale.
hl.monitor({ output = "", mode = "preferred", position = "auto", scale = "auto" })

-- One monitor (laptop, HiDPI panel at 2x):
-- hl.monitor({ output = "eDP-1", mode = "preferred", position = "auto", scale = 2 })

-- Three monitors side by side (desktop). Positions are logical pixels, left to right:
-- hl.monitor({ output = "DP-1",     mode = "2560x1440@144", position = "0x0",    scale = 1 })
-- hl.monitor({ output = "DP-2",     mode = "2560x1440@144", position = "2560x0", scale = 1 })
-- hl.monitor({ output = "HDMI-A-1", mode = "1920x1080@60",  position = "5120x0", scale = 1 })
